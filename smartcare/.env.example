# Public Appwrite configuration (safe to expose to the browser)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://appwrite.example.com/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your-database-id

# Server-only credentials — set these in your deployment environment, never commit them.
APPWRITE_API_KEY=replace-with-server-api-key
GMAIL_USER=notifications@example.com
GMAIL_APP_PASSWORD=replace-with-mail-app-password
GROQ_API_KEY=replace-with-groq-api-key
SENTRY_AUTH_TOKEN=replace-with-sentry-auth-token
